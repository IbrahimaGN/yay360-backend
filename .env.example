# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env est ignoré par git : ne jamais le versionner.
# Il est lu par docker-compose ET par l'API lancée en local (mvnw spring-boot:run).

# ---------- Base de données ----------
DB_USER=postgres
# Port de la base Docker sur la machine (5432 est pris par le PostgreSQL de Windows)
DB_HOST_PORT=5433
DB_PASSWORD=changer-moi
# Utilisés par l'API lancée en local (hors Docker) : ici, la base Docker sur le port 5433
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/yay360
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changer-moi

# ---------- Sécurité ----------
# 32 caractères minimum. Générer par exemple avec :
#   openssl rand -base64 48
JWT_SECRET=

# Mot de passe du compte admin@yay360.sn créé au premier démarrage.
# Laisser vide : un mot de passe aléatoire est généré et affiché une fois dans les logs.
YAY360_ADMIN_PASSWORD=

# ---------- Démonstration (soutenance) ----------
# true : crée des comptes et dossiers fictifs (*.demo@yay360.sn). Jamais en production.
YAY360_DEMO_DATA_ENABLED=false
# Vide : un mot de passe aléatoire est généré et affiché une fois dans les logs
YAY360_DEMO_PASSWORD=

# ---------- Front et documentation ----------
# URL du web, utilisée dans les liens envoyés par email
YAY360_FRONTEND_URL=http://localhost:4200
# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# Ajouter l'IP du poste pour tester le mobile sur le réseau local, ex. http://192.168.1.10:*
YAY360_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*
# Swagger UI : désactivé par défaut ; true en développement / soutenance
YAY360_SWAGGER_ENABLED=true

# ---------- Règles cliniques complémentaires ----------
# FC maternelle, protéinurie, glycosurie (seuils ISSHP, NICE NG3, MEOWS) ; false pour seulement enregistrer les valeurs
YAY360_REGLES_COMPLEMENTAIRES_ACTIVES=true

# ---------- Emails (facultatif) ----------
# Brevo (API HTTPS, offre gratuite) : prioritaire sur SMTP, obligatoire sur Render gratuit (SMTP bloqué).
# Sert aussi à envoyer les codes de connexion mobile. Clé : Brevo > SMTP & API > API Keys.
BREVO_API_KEY=
YAY360_MAIL_EXPEDITEUR_NOM=YAY360
# Sans SMTP_HOST, aucun email n'est envoyé (le code d'invitation est alors remis à la patiente).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
YAY360_MAIL_FROM=no-reply@yay360.sn
# DÉVELOPPEMENT UNIQUEMENT : sans SMTP, écrit les liens de réinitialisation dans les logs
YAY360_MAIL_JOURNALISER_LIENS=false
